# Public origins. Use hostnames configured as published applications on one Cloudflare Tunnel.
TROTTER_API_URL=https://api.example.com
TROTTER_API_HOST=api.example.com
TROTTER_WEB_URL=https://app.example.com

# Loopback-only diagnostics on the home server.
TROTTER_LOCAL_API_PORT=8000
TROTTER_LOCAL_WEB_PORT=8080

# Database identity. The password lives in deploy/secrets/postgres_password.
POSTGRES_DB=trotter
POSTGRES_USER=trotter

# Google OAuth web client. The secret lives in deploy/secrets/google_client_secret.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Worker sizing. Start conservatively and increase after observing CPU and memory.
TROTTER_CELERY_CONCURRENCY=2
TROTTER_PARSE_WORKERS=4
TROTTER_ENABLE_AUTOMATIC_BACKFILL=true
TROTTER_ENABLE_RECALL_DISCOVERY_TIERS=true

# Optional enrichment services.
AERODATABOX_ENABLED=true
AERODATABOX_RAPIDAPI_KEY=
AERODATABOX_APIMARKET_KEY=
AERODATABOX_PROVIDER_ORDER=rapidapi,apimarket
AERODATABOX_MAX_LOOKUPS_PER_SYNC=60
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=

# Hosted Dreams extraction. The Venice key lives in deploy/secrets/venice_api_key.
DREAM_AI_PROVIDER=venice
DREAM_AI_BASE_URL=https://api.venice.ai/api/v1
DREAM_AI_PRIMARY_MODEL=qwen3-5-9b
DREAM_AI_FALLBACK_MODEL=kimi-k2-5
DREAM_AI_ENABLE_FALLBACK=true
DREAM_AI_TIMEOUT_SECONDS=30
DREAM_AI_MAX_ATTEMPTS=2

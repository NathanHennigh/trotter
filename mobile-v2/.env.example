EXPO_PUBLIC_TROTTER_API_URL=https://trotter-api.thehennighs.com
# Maps SDK keys are distinct from the protected backend Places key.
# For local/WSL builds use android/google-maps.properties; see its example.
# iPhone: enable Maps SDK for iOS; restrict this key to com.trotter.mobilev2.
GOOGLE_MAPS_IOS_API_KEY=
# Actual values from Expo / Apple Developer; never use made-up identifiers.
EAS_PROJECT_ID=
APPLE_TEAM_ID=
# Keep false until Trotter's Apple login credentials and real-device flow are verified.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false

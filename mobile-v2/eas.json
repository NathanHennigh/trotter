{
  "cli": {
    "version": ">= 15.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "iphone-simulator": {
      "extends": "development",
      "environment": "development",
      "ios": { "simulator": true }
    },
    "iphone-development": {
      "extends": "development",
      "environment": "development",
      "ios": { "simulator": false }
    },
    "iphone-testflight": {
      "distribution": "store",
      "environment": "production",
      "ios": { "autoIncrement": "buildNumber" }
    }
  },
  "submit": {
    "iphone-testflight": { "ios": { "ascAppId": "6828049706", "appleTeamId": "BVA33376DZ" } }
  }
}

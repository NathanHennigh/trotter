{
  "expo": {
    "name": "Trotter",
    "slug": "trotter-v2",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "trotterv2",
    "userInterfaceStyle": "light",
    "icon": "./assets/world-window/app-icon.png",
    "newArchEnabled": true,
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trotter.mobilev2"
    },
    "android": {
      "package": "com.trotter.mobilev2",
      "adaptiveIcon": {
        "foregroundImage": "./assets/world-window/app-icon.png",
        "backgroundColor": "#FAF8F2"
      }
    },
    "extra": {
      "eas": {
        "projectId": "local-v2-placeholder"
      }
    }
  }
}

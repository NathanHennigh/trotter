{
  "expo": {
    "name": "Trotter",
    "slug": "trotter-v2",
    "version": "0.1.2",
    "orientation": "portrait",
    "scheme": "trotterv2",
    "userInterfaceStyle": "light",
    "icon": "./assets/world-window/app-icon.png",
    "newArchEnabled": true,
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/withTrotterShareExtension"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trotter.mobilev2",
      "appleTeamId": "BVA33376DZ",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Allow Trotter to show your position on the map alongside your saved places."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.trotter.mobilev2",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/world-window/app-icon.png",
        "backgroundColor": "#FAF8F2"
      }
    },
    "extra": {
      "eas": {
        "projectId": "99fd8582-8058-41da-b72f-bd09e78ac528"
      }
    },
    "owner": "nathanhennigh"
  }
}

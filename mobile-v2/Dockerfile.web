FROM node:20.20.2-alpine AS build

WORKDIR /app

ARG EXPO_PUBLIC_TROTTER_API_URL
ENV EXPO_PUBLIC_TROTTER_API_URL=$EXPO_PUBLIC_TROTTER_API_URL

RUN case "$EXPO_PUBLIC_TROTTER_API_URL" in https://*) ;; *) echo 'EXPO_PUBLIC_TROTTER_API_URL must be an HTTPS URL' >&2; exit 1 ;; esac

COPY mobile-v2/package.json mobile-v2/package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund

COPY mobile-v2/ ./
RUN npx expo export --platform web --output-dir dist

FROM nginx:stable-alpine

COPY mobile-v2/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

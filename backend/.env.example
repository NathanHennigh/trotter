# backend/.env.example  —  copy to .env and fill in values

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
# Credential type: Web application
# Authorized redirect URI: {BACKEND_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Backend public URL ────────────────────────────────────────────────────────
# This is where your FastAPI server is reachable from the internet/device.
# Production home-server setup is documented in deploy/README.md.
BACKEND_URL=https://xxxx.ngrok-free.app
WEB_APP_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./trotter.db

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=generate-with--python-c-"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-random-32-char-string-here

# ── Dev mode ──────────────────────────────────────────────────────────────────
# Set to true to enable /auth/dev-token endpoint (NEVER in production)
DEV_MODE=true

# ── Celery/Redis (for Gmail import background jobs) ───────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Optional flight detail enrichment (AeroDataBox)
# Keep these keys local. Do not commit real values.
# RapidAPI is tried first by default because it usually has the larger monthly request allowance.
AERODATABOX_RAPIDAPI_KEY=
AERODATABOX_APIMARKET_KEY=
AERODATABOX_PROVIDER_ORDER=rapidapi,apimarket
AERODATABOX_RAPIDAPI_MIN_INTERVAL_SECONDS=0.25
AERODATABOX_APIMARKET_MIN_INTERVAL_SECONDS=1.05
AERODATABOX_MAX_LOOKUPS_PER_SYNC=60
AERODATABOX_NEGATIVE_CACHE_DAYS=90
